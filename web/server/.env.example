# server/.env  (copy this file to .env and fill in)
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/citycare?retryWrites=true&w=majority

# Any long random text. Used to sign staff login sessions.
JWT_SECRET=change-me-to-a-long-random-string

# First staff account, created automatically on first start
ADMIN_EMAIL=admin@citycareclinic.in
ADMIN_PASSWORD=change-me
ADMIN_NAME=Clinic Admin

# Same LiveKit values as the agent's .env
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Leave empty while the agent runs with RECEPTIONIST_AGENT_NAME= (empty)
LIVEKIT_AGENT_NAME=
LIVEKIT_AGENT_CONFIG=myclinic

# Shared secret: put the SAME value as DASHBOARD_WEBHOOK_SECRET in the agent's .env
DASHBOARD_WEBHOOK_SECRET=change-me-shared-secret

# Google Calendar: reuse the token the agent created
GOOGLE_OAUTH_TOKEN_FILE=../../AIReceptionist/secrets/myclinic/google-calendar-oauth.json
GOOGLE_CALENDAR_ID=primary
CLINIC_TIMEZONE=Asia/Kolkata

# Optional: Gemini key for automatic call summaries (same key as the agent)
GOOGLE_API_KEY=
